# Copy to .env.local for local dev. On Vercel, add these under Project → Settings → Environment Variables.

# Public URL of the app, no trailing slash (http://localhost:3000 locally).
APP_URL=https://your-app.vercel.app

# The only Google account allowed to sign in.
ALLOWED_EMAIL=you@gmail.com

# Long random strings. Generate each with: openssl rand -base64 32
SESSION_SECRET=
CRON_SECRET=

# Google Cloud → APIs & Services → Credentials → your OAuth 2.0 Client (Web application).
# Used for sign-in and for Social → Connect Google account (redirect URI: APP_URL/api/social/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase → Project Settings → API. The service role key is server-only; never expose it.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key from console.anthropic.com, used for the recommendations.
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# GSC_BACKFILL_DAYS=90
# GSC_INSPECT_LIMIT=40
# AI_REPORT_EVERY_DAYS=7

# Social Automation. Encrypts Google and social account tokens at rest. Required for Connect Google account. 32 random bytes: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Content Studio AI. Text and research are separate; see README "Content planning and drafts".
# CONTENT_AI_PROVIDER=anthropic   # anthropic | xai | openai_compatible
# CONTENT_AI_MODEL=
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# RESEARCH_PROVIDER=              # brave | tavily
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=
# RESEARCH_PRICE_PER_CALL=
# Facebook Pages and Instagram publishing (docs/meta-setup.md). Redirect URI: APP_URL/api/social/meta/callback
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v26.0
# Later platforms. Leave empty until their adapters exist.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
